[Unit]
Description=Catty Reminders App
After=network.target

[Service]
Type=simple
User=ubu
WorkingDirectory=/home/ubu/app-code
ExecStart=/bin/bash -c "export DEPLOY_REF=$$(git rev-parse HEAD) && exec /home/ubu/app-venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8181"
Restart=always

[Install]
WantedBy=multi-user.target
